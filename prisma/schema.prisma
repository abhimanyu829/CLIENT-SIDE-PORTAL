  fulfillmentPlan Json            @default("{}")
  metadata        Json            @default("{}")
  paidAt          DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user                User                  @relation(fields: [userId], references: [id])
  cart                Cart?                 @relation(fields: [cartId], references: [id])
  items               OrderItem[]
  payments            Payment[]
  paymentVerification PaymentVerification?
  invoices            Invoice[]
  entitlements        CustomerEntitlement[]
  metricEvents        PlatformMetricEvent[]
  purchasedServices   PurchasedService[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([affiliateCode])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String
  tierId            String?
  vendorId          String?
  name              String
  itemType          ProductType
  fulfillmentType   FulfillmentType @default(HOSTED)
  quantity          Int             @default(1)
  unitPrice         Decimal         @db.Decimal(12, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(12, 2)
  platformFee       Decimal         @default(0) @db.Decimal(12, 2)
  vendorNetAmount   Decimal         @default(0) @db.Decimal(12, 2)
  currency          String          @default("USD")
  entitlementConfig Json            @default("{}")
  fulfillmentStatus String          @default("PENDING")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  tier    ProductTier? @relation(fields: [tierId], references: [id])
  purchasedService PurchasedService[]

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
}

model CustomerEntitlement {
  id                   String          @id @default(cuid())
  userId               String
  productId            String
  orderId              String?
  subscriptionId       String?
  status               String          @default("ACTIVE")
  accessType           FulfillmentType
  quota                Json            @default("{}")
  usage                Json            @default("{}")
  apiKeyPrefix         String?
  startsAt             DateTime        @default(now())
  expiresAt            DateTime?
  metadata             Json            @default("{}")
  // Encrypted credential snapshot — AES-256-GCM encrypted JSON
  // Decrypted ONLY server-side for verified owners via /api/entitlements/[id]/credentials
  credentialSnapshot   String?         @db.Text
  // 3-hour refund eligibility window
  refundEligibleUntil  DateTime?
  refundRequested      Boolean         @default(false)
  refundRequestedAt    DateTime?
  refundRequestReason  String?
  // Subscription lifecycle
  gracePeriodEndsAt    DateTime?
  accessRevokedAt      DateTime?
  revocationReason     String?
  previewAccessRevoked Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id])
  refundRequests RefundRequest[]
  credentialRequests CredentialRequest[]

  @@index([userId, status])
  @@index([productId])
  @@index([orderId])
  @@index([subscriptionId])
  @@index([refundEligibleUntil])
}

model RefundRequest {
  id              String    @id @default(cuid())
  userId          String
  paymentId       String
  orderId         String?
  entitlementId   String?
  reason          String    @db.Text
  status          String    @default("PENDING")
  // PENDING | APPROVED | REJECTED | PROCESSED | CANCELLED
  gateway         String?
  gatewayRefundId String?
  refundAmount    Decimal   @db.Decimal(12, 2)
  requestedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  adminNotes      String?
  auditTrail      Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id])
  entitlement CustomerEntitlement? @relation(fields: [entitlementId], references: [id])

  @@index([userId, status])
  @@index([paymentId])
  @@index([status])
  @@index([requestedAt])
  @@index([entitlementId])
}

// ── Credential Request System ─────────────────────────────────────────────────

enum CredentialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

model CredentialRequest {
  id               String                  @id @default(cuid())
  userId           String
  productId        String
  entitlementId    String
  email            String
  reason           String?                 @db.Text
  status           CredentialRequestStatus @default(PENDING)
  adminNotes       String?                 @db.Text
  // Admin-entered credentials for delivery
  deliveredUsername String?
  deliveredPassword String?
  // Whether admin enabled in-dashboard credential viewing
  allowDashboard   Boolean                 @default(false)
  // Encrypted payload for dashboard delivery (AES-256-GCM)
  credentialPayload String?                @db.Text
  requestedAt      DateTime                @default(now())
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])
  entitlement CustomerEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([userId, status])
