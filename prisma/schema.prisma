// ── Campaign & Offers ─────────────────────────────────────────────────────────

enum CampaignType {
  FESTIVAL
  FLASH
  REFERRAL
  LOYALTY
  BLACKFRIDAY
  INFLUENCER
  AB_TEST
  RETENTION
  AFFILIATE
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

model Campaign {
  id                   String         @id @default(cuid())
  name                 String
  label                String?
  description          String?
  type                 CampaignType
  status               CampaignStatus @default(DRAFT)
  startsAt             DateTime
  endsAt               DateTime
  discountPercent      Float          @default(0)
  flatDiscount         Decimal?       @db.Decimal(10, 2)
  bannerText           String?
  bannerImageUrl       String?
  ctaText              String?
  ctaUrl               String?
  applicableTierIds    String[]
  applicableProductIds String[]
  targetSegment        String? // all, new_users, returning, subscribers
  allowedGeos          String[]
  // A/B test
  isAbTest             Boolean        @default(false)
  abVariantA           Json?
  abVariantB           Json?
  // Analytics
  impressions          Int            @default(0)
  clicks               Int            @default(0)
  conversions          Int            @default(0)
  revenue              Decimal        @default(0) @db.Decimal(10, 2)
  isActive             Boolean        @default(false)
  createdBy            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  coupons              Coupon[]

  @@index([isActive, startsAt, endsAt])
  @@index([status])
}

// ── Feature Flags ─────────────────────────────────────────────────────────────

model FeatureFlag {
  id             String   @id @default(cuid())
  name           String   @unique // e.g. "enable_ai_chat"
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(100) // 0-100 percentage of users to enable for
  targetUserIds  String[] // explicit user allowlist (overrides rollout)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

// ── Teams ─────────────────────────────────────────────────────────────────────

enum TeamMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Team {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  ownerId      String
  billingEmail String?
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  members      TeamMember[]

  @@index([ownerId])
}

model TeamMember {
  id           String         @id @default(cuid())
  teamId       String
  userId       String
  role         TeamMemberRole @default(MEMBER)
  inviteStatus InviteStatus   @default(PENDING)
  invitedBy    String?
  invitedAt    DateTime       @default(now())
  acceptedAt   DateTime?
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ── AI Usage Logs ─────────────────────────────────────────────────────────────

model AIUsageLog {
  id               String        @id @default(cuid())
  userId           String
  model            String // e.g. "gpt-4o", "gpt-4o-mini"
  endpoint         String // e.g. "/api/ai/chat"
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  costUsd          Decimal       @default(0) @db.Decimal(10, 8)
  latencyMs        Int           @default(0)
  status           AIUsageStatus @default(SUCCESS)
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([model])
  @@index([status])
}

// ── Webhook Events (Idempotency + Replay) ─────────────────────────────────────

model WebhookEvent {
  id            String        @id @default(cuid())
  source        WebhookSource
  eventType     String // e.g. "payment_intent.succeeded"
  eventId       String        @unique // idempotency key from gateway
  payload       Json
  status        WebhookStatus @default(PENDING)
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([source])
  @@index([eventType])
  @@index([createdAt])
}

// ── Pricing History (Immutable price ledger) ───────────────────────────────────

model PricingHistory {
  id          String      @id @default(cuid())
  tierId      String
  productId   String
  oldPrice    Decimal     @db.Decimal(10, 2)
  newPrice    Decimal     @db.Decimal(10, 2)
  currency    String      @default("USD")
  interval    String // BillingInterval as string for historical immutability
  changedBy   String // adminId
  reason      String?
  effectiveAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  tier        ProductTier @relation(fields: [tierId], references: [id])

  @@index([tierId])
  @@index([effectiveAt])
  @@index([changedBy])
}

// ── Product Version History (Immutable snapshot ledger) ────────────────────────

model ProductVersion {
  id            String   @id @default(cuid())
  productId     String
  version       Int
  snapshot      Json
  changedBy     String
  changedByName String?
  changeNote    String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([changedBy])
  @@index([createdAt])
}

// ── Coupon Usage Tracking ──────────────────────────────────────────────────────

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  discount Decimal  @db.Decimal(10, 2)
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
  SUPPRESSED
}

enum EmailProviderName {
  RESEND
  SENDGRID
  POSTMARK
  SES
  MAILGUN
}

enum DeliveryState {
  QUEUED
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  DROPPED
}

enum EmailAudienceType {
  ALL_USERS
  ACTIVE_SUBSCRIBERS
  EXPIRED_SUBSCRIBERS
  BY_PRODUCT
  BY_PLAN
  BY_ROLE
  INDIVIDUAL
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  SPAM_COMPLAINT
  MANUAL
  INVALID_ADDRESS
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

model EmailCampaign {
  id                String             @id @default(cuid())
  name              String
  subject           String
  templateName      String
  payload           Json               @default("{}")
  audienceType      EmailAudienceType
  audienceFilter    Json?
  status            EmailCampaignStatus @default(DRAFT)
  createdByAdminId  String
  scheduledAt       DateTime?
  sentAt            DateTime?
  totalRecipients   Int                @default(0)
  sentCount         Int                @default(0)
  deliveredCount    Int                @default(0)
  openedCount       Int                @default(0)
  clickedCount      Int                @default(0)
  bouncedCount      Int                @default(0)
  unsubscribeCount  Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  createdByAdmin    User               @relation(fields: [createdByAdminId], references: [id], onDelete: Cascade)
  queueItems        EmailQueue[]

  @@index([status, scheduledAt])
  @@index([createdByAdminId])
}

model EmailQueue {
  id             String    @id @default(cuid())
  emailType      String
  recipient      String
  sender         String    @default("noreply@nexusai.com")
  subject        String
  templateName   String
  payload        Json      @default("{}")
  status         EmailStatus @default(PENDING)
  priority       Int       @default(5)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextRetryAt    DateTime?
  lastError      String?
  campaignId     String?
  userId         String?
  orderId        String?
  subscriptionId String?
  productId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign       EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  log            EmailLog?

  @@index([status, nextRetryAt])
  @@index([emailType])
  @@index([userId])
  @@index([campaignId])
}

model EmailLog {
  id             String          @id @default(cuid())
  queueId        String          @unique
  emailType      String
  recipient      String
  sender         String
  provider       EmailProviderName @default(RESEND)
  status         EmailStatus
  deliveryState  DeliveryState   @default(QUEUED)
  providerMsgId  String?
  providerResponse Json?
  retries        Int             @default(0)
  failureReason  String?
  userId         String?
  orderId        String?
  subscriptionId String?
  productId      String?
  queuedAt       DateTime        @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  failedAt       DateTime?

  queue          EmailQueue      @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([recipient])
  @@index([emailType])
  @@index([deliveryState])
  @@index([userId])
  @@index([orderId])
}

model RateLimit {
  id          String   @id @default(cuid())
  bucketKey   String   @unique
  tokens      Int
  windowStart DateTime @default(now())
  windowSecs  Int      @default(3600)
  maxTokens   Int      @default(10)
  updatedAt   DateTime @updatedAt

  @@index([bucketKey])
}

model EmailSuppression {
  id          String           @id @default(cuid())
  email       String           @unique
  reason      SuppressionReason
  emailTypes  String[]
  source      String?
  createdAt   DateTime         @default(now())

  @@index([email])
}

model EmailPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  transactional    Boolean  @default(true)
  subscriptionMail  Boolean  @default(true)
  marketing        Boolean  @default(true)
  newsletter       Boolean  @default(true)
  productUpdates   Boolean  @default(true)
  unsubscribeToken String   @unique
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// ── Services Section (Independent Layer) ──────────────────────────────────────

model ServiceCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  services    ServicePage[]
  premiumServices PremiumService[]
}

model ServicePage {
  id               String             @id @default(cuid())
  categoryId       String?
  slug             String             @unique
  title            String
  heroHeading      String
  heroSubheading   String
  heroImageUrl     String?
  overview         String             @db.Text
  businessBenefits Json               @default("[]")
  technicalBenefits Json              @default("[]")
  workflow         Json               @default("[]")
  useCases         Json               @default("[]")
  industriesServed String[]
  pricingGuidance  String?            @db.Text
  isActive         Boolean            @default(true)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  category         ServiceCategory?   @relation(fields: [categoryId], references: [id])
  features         ServiceFeature[]
  technologies     ServiceTechnology[]
  faqs             ServiceFaq[]
  portfolios       ServicePortfolio[]
  plans            ServicePlan[]
  addOns           ServiceAddon[]
  requests         ServiceRequest[]
  leads            ServiceLead[]
  orders           ServiceOrder[]
  serviceSubscriptions ServiceSubscription[]
  serviceOwnerships    ServiceOwnership[]
  serviceEntitlements  ServiceEntitlement[]
  mediaAssets      ServiceMediaAsset[]
  documents        ServiceDocument[]
  discoveryTags    ServiceDiscoveryTagAssignment[]
  discoveryCollectionItems ServiceDiscoveryCollectionItem[]
  discoveryEvents  ServiceDiscoveryEvent[]
  campaignEvents   ServiceCampaignEvent[]
}

// Service discovery is intentionally isolated from marketplace campaigns and orders.
// It only references service catalog records and optional viewer identities.
enum ServiceDiscoveryEventType {
  VIEW
  CLICK
  SEARCH
  WISHLIST_SIGNAL
  CART_SIGNAL
  PURCHASE_SIGNAL
}

enum ServiceCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ARCHIVED
  COMPLETED
}

enum ServiceCampaignEventType {
  IMPRESSION
  CLICK
  CONVERSION
}

model ServiceDiscoveryTag {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments ServiceDiscoveryTagAssignment[]

  @@index([isFeatured])
}

model ServiceDiscoveryTagAssignment {
  servicePageId String
  tagId         String
  createdAt     DateTime @default(now())
  servicePage   ServicePage          @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  tag           ServiceDiscoveryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([servicePageId, tagId])
  @@index([tagId])
}

model ServiceDiscoveryCollection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  placement   String   @default("services")
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  audience    Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       ServiceDiscoveryCollectionItem[]

  @@index([placement, isActive, priority])
}

model ServiceDiscoveryCollectionItem {
  collectionId String
  servicePageId String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  collection   ServiceDiscoveryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  servicePage  ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)

  @@id([collectionId, servicePageId])
  @@index([servicePageId])
}

model ServiceDiscoveryCampaign {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  description     String?
  status          ServiceCampaignStatus @default(DRAFT)
  placement       String                @default("services")
  bannerUrl       String?
  thumbnailUrl    String?
  backgroundUrl   String?
  videoUrl        String?
  ctaLabel        String?
  landingUrl      String?
  startsAt        DateTime?
  endsAt          DateTime?
  priority        Int                   @default(0)
  targetAudience  Json                  @default("{}")
  categorySlugs   String[]
  relatedServiceIds String[]
  relatedProductIds String[]
  tags            String[]
  createdById     String?
  archivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  events          ServiceCampaignEvent[]

  @@index([status, placement, priority])
  @@index([startsAt, endsAt])
}

model ServiceDiscoveryEvent {
  id            String                    @id @default(cuid())
  userId        String?
  sessionKey    String?
  servicePageId String?
  eventType     ServiceDiscoveryEventType
  query         String?
  metadata      Json                      @default("{}")
  occurredAt    DateTime                  @default(now())
  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  servicePage   ServicePage?              @relation(fields: [servicePageId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([sessionKey, occurredAt])
  @@index([servicePageId, eventType, occurredAt])
}

model ServiceInterestProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  categoryScores Json     @default("{}")
  tagScores      Json     @default("{}")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCampaignEvent {
  id          String                      @id @default(cuid())
  campaignId  String
  userId      String?
  sessionKey  String?
  servicePageId String?
  eventType   ServiceCampaignEventType
  value       Decimal?                    @db.Decimal(12, 2)
  createdAt   DateTime                    @default(now())
  campaign    ServiceDiscoveryCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  servicePage ServicePage?                @relation(fields: [servicePageId], references: [id], onDelete: SetNull)

  @@index([campaignId, eventType, createdAt])
  @@index([userId, createdAt])
}

// Standalone client-to-team project discovery portal. These records deliberately
// do not participate in marketplace orders, service checkout, or service leads.
enum CustomServiceRequestStatus {
  NEW
  UNDER_REVIEW
  DISCUSSION
  PROPOSAL_SENT
  APPROVED
  IN_DEVELOPMENT
  COMPLETED
  CLOSED
}

enum CustomServiceMessageSenderType {
  CLIENT
  ADMIN
}

model CustomServicePortalSetting {
  id          String   @id @default("custom-service-portal")
  isEnabled   Boolean  @default(true)
  publicPath  String   @default("/request-service")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("CustomServicePortalSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model CustomServiceRequest {
  id              String                     @id @default(cuid())
  requestNumber   String                     @unique
  clientId        String
  fullName        String
  email           String
  phone           String?
  companyName     String?
  serviceCategory String
  projectTitle    String
  ideaDescription String                     @db.Text
  problemStatement String?                   @db.Text
  requestedFeatures String?                  @db.Text
  targetUsers     String?
  expectedBudget  String?
  expectedTimeline String?
  additionalNotes String?                    @db.Text
  status          CustomServiceRequestStatus @default(NEW)
  lastActivityAt  DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  client          User                       @relation("CustomServiceRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  attachments     CustomServiceRequestAttachment[]
  messages        CustomServiceDiscussionMessage[]

  @@index([clientId, status])
  @@index([status, lastActivityAt])
  @@index([email])
}

model CustomServiceRequestAttachment {
  id          String   @id @default(cuid())
  requestId   String
  messageId   String?
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  url         String
  createdAt   DateTime @default(now())
  request     CustomServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message     CustomServiceDiscussionMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([messageId])
}

model CustomServiceDiscussionMessage {
  id          String                         @id @default(cuid())
  requestId   String
  senderId    String
  senderType  CustomServiceMessageSenderType
  body        String                         @db.Text
  isInternal  Boolean                        @default(false)
  isRead      Boolean                        @default(false)
  createdAt   DateTime                       @default(now())
  request     CustomServiceRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender      User                           @relation("CustomServiceMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments CustomServiceRequestAttachment[]

  @@index([requestId, createdAt])
  @@index([senderId, createdAt])
}

model ServiceFeature {
  id            String      @id @default(cuid())
  servicePageId String
  title         String
  description   String      @db.Text
  icon          String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
}

model ServiceTechnology {
  id            String      @id @default(cuid())
  servicePageId String
  name          String
  iconUrl       String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
}

model ServiceFaq {
  id            String      @id @default(cuid())
  servicePageId String
  question      String
  answer        String      @db.Text
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
}

model ServicePortfolio {
  id            String      @id @default(cuid())
  servicePageId String
  title         String
  description   String      @db.Text
  imageUrl      String?
  projectUrl    String?
  results       Json        @default("[]")
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
}

model ServiceLead {
  id                  String       @id @default(cuid())
  servicePageId       String?
  inquiryType         ServiceInquiryType @default(CONTACT)
  name                String
  email               String
  phone               String?
  company             String?
  projectRequirements String       @db.Text
  status              LeadStage    @default(NEW)
  notifiedAdmin       Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  servicePage         ServicePage? @relation(fields: [servicePageId], references: [id], onDelete: SetNull)
}

enum ServiceInquiryType {
  CONTACT
  PROJECT_REQUEST
  CONSULTATION
  ENTERPRISE
}

enum ServicePlanType {
  SUBSCRIPTION
  ONE_TIME
}

enum ServiceRequestType {
  CANCELLATION
  REFUND
  FEATURE
  DESIGN_CHANGE
  BUG_FIX
  MIGRATION
  CUSTOMIZATION
  CONSULTATION
  PERFORMANCE_UPGRADE
  DATABASE_UPGRADE
  SECURITY_UPGRADE
  INFRASTRUCTURE_UPGRADE
}

enum ServiceRequestStatus {
  OPEN
  APPROVED
  REJECTED
  CLOSED
}

enum ServiceOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  ACTIVE
  CANCELLED
  FAILED
  EXPIRED
}

enum ServiceOrderLineType {
  PLAN
  ADDON
}

enum ServiceSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ServiceOwnershipStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ServiceEntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ServiceMediaType {
  SCREENSHOT
  VIDEO
  DEMO
  PREVIEW
}

enum ServiceDocumentType {
  DOCUMENTATION
  PROPOSAL
  TERMS
  GUIDE
}

model ServicePlan {
  id            String           @id @default(cuid())
  servicePageId String
  type          ServicePlanType
  name          String
  billingLabel  String?
  price         Decimal          @db.Decimal(12, 2)
  currency      String           @default("USD")
  description   String?          @db.Text
  features      Json             @default("[]")
  isPopular     Boolean          @default(false)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  servicePage   ServicePage      @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]   @relation("ServiceOrderPrimaryPlan")
  orderLines    ServiceOrderLine[] @relation("ServiceOrderLinePlan")

  @@index([servicePageId, type])
}

model ServiceAddon {
  id            String      @id @default(cuid())
  servicePageId String
  name          String
  description   String?     @db.Text
  price         Decimal     @db.Decimal(12, 2)
  currency      String      @default("USD")
  enabled       Boolean     @default(true)
  bundleOnly    Boolean     @default(false)
  restricted    Boolean     @default(false)
  isPopular     Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  servicePage   ServicePage @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  orderLines    ServiceOrderLine[] @relation("ServiceOrderLineAddon")

  @@index([servicePageId])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  servicePageId String?
  serviceOrderId String?
  purchasedServiceId String?
  type          ServiceRequestType
  status        ServiceRequestStatus @default(OPEN)
  name          String
  email         String
  orderRef      String?
  reason        String              @db.Text
  refundAmount  Decimal?            @db.Decimal(12, 2)
  currency      String              @default("USD")
  refundEligibleUntil DateTime?
  adminNotes    String?             @db.Text
  reviewedBy    String?
  reviewedAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  servicePage   ServicePage?        @relation(fields: [servicePageId], references: [id], onDelete: SetNull)
  order         ServiceOrder?       @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([servicePageId, type, status])
  @@index([serviceOrderId, type, status])
}

model ServiceOrder {
  id             String            @id @default(cuid())
  orderNumber    String            @unique
  userId         String
  servicePageId  String
  servicePlanId  String
  status         ServiceOrderStatus @default(PENDING_PAYMENT)
  currency       String            @default("USD")
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal           @default(0) @db.Decimal(12, 2)
  billingSnapshot Json             @default("{}")
  metadata       Json              @default("{}")
  paidAt         DateTime?
  fulfilledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePage    ServicePage       @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  servicePlan    ServicePlan       @relation("ServiceOrderPrimaryPlan", fields: [servicePlanId], references: [id])
  lines          ServiceOrderLine[]
  subscriptions  ServiceSubscription[]
  ownerships     ServiceOwnership[]
  entitlements   ServiceEntitlement[]
  requests       ServiceRequest[]

  @@index([userId, status])
  @@index([servicePageId, status])
}

model ServiceOrderLine {
  id             String            @id @default(cuid())
  serviceOrderId  String
  lineType       ServiceOrderLineType
  servicePlanId  String?
  serviceAddonId  String?
  name           String
  quantity       Int               @default(1)
  unitPrice      Decimal           @db.Decimal(12, 2)
  totalPrice     Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  snapshot       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order          ServiceOrder      @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  plan           ServicePlan?      @relation("ServiceOrderLinePlan", fields: [servicePlanId], references: [id])
  addon          ServiceAddon?     @relation("ServiceOrderLineAddon", fields: [serviceAddonId], references: [id])

  @@index([serviceOrderId])
  @@index([lineType])
}

model ServiceSubscription {
  id             String                   @id @default(cuid())
  userId         String
  servicePageId  String
  serviceOrderId String
  status         ServiceSubscriptionStatus @default(ACTIVE)
  startsAt       DateTime                 @default(now())
  endsAt         DateTime?
  metadata       Json                     @default("{}")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePage    ServicePage              @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  order          ServiceOrder             @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  ownerships     ServiceOwnership[]
  entitlements   ServiceEntitlement[]

  @@index([userId, status])
  @@index([servicePageId, status])
  @@index([serviceOrderId])
}

model ServiceOwnership {
  id                  String                 @id @default(cuid())
  userId              String
  servicePageId       String
  serviceOrderId      String
  serviceSubscriptionId String?
  status              ServiceOwnershipStatus @default(ACTIVE)
  assignedAt          DateTime               @default(now())
  expiresAt           DateTime?
  metadata            Json                   @default("{}")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePage         ServicePage            @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  order               ServiceOrder           @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  subscription        ServiceSubscription?   @relation(fields: [serviceSubscriptionId], references: [id], onDelete: SetNull)
  entitlements        ServiceEntitlement[]

  @@index([userId, status])
  @@index([servicePageId, status])
  @@index([serviceOrderId])
}

model ServiceEntitlement {
  id                  String                    @id @default(cuid())
  userId              String
  servicePageId       String
  serviceOrderId      String
  serviceSubscriptionId String?
  serviceOwnershipId  String?
  status              ServiceEntitlementStatus  @default(ACTIVE)
  accessType          String
  startsAt            DateTime                  @default(now())
  endsAt              DateTime?
  credentialsSnapshot Json                      @default("{}")
  metadata            Json                      @default("{}")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePage         ServicePage               @relation(fields: [servicePageId], references: [id], onDelete: Cascade)
  order               ServiceOrder              @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  subscription        ServiceSubscription?      @relation(fields: [serviceSubscriptionId], references: [id], onDelete: SetNull)
  ownership           ServiceOwnership?         @relation(fields: [serviceOwnershipId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([servicePageId, status])
  @@index([serviceOrderId])
}

model ServiceMediaAsset {
  id            String           @id @default(cuid())
  servicePageId String
  mediaType     ServiceMediaType
  title         String
  url           String
  caption       String?          @db.Text
  altText       String?
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  servicePage   ServicePage      @relation(fields: [servicePageId], references: [id], onDelete: Cascade)

  @@index([servicePageId, mediaType, isActive])
}

model ServiceDocument {
  id            String             @id @default(cuid())
  servicePageId String
  documentType  ServiceDocumentType @default(DOCUMENTATION)
  title         String
  slug          String
  summary       String?            @db.Text
  content       String?            @db.Text
  previewUrl    String?
  demoUrl       String?
  version       String             @default("1.0")
  isPublished   Boolean            @default(true)
  sortOrder     Int                @default(0)
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  servicePage   ServicePage        @relation(fields: [servicePageId], references: [id], onDelete: Cascade)

  @@unique([servicePageId, slug])
  @@index([servicePageId, documentType, isPublished])
}

// ==============================================================================
// ── Subscription & Billing Center Enums ───────────────────────────────────────
// ==============================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
  LIFETIME
  USAGE_BASED
}

enum PriceCurrency {
  USD
  EUR
  GBP
  INR
  CAD
  AUD
}

enum PlanTier {
  FREE
  STARTER
  PRO
  AGENCY
  ENTERPRISE
}

enum BenefitType {
  FEATURE
  LIMIT
  SUPPORT
  INTEGRATION
  DISCOUNT
}

enum AddonPricingType {
  FLAT_RECURRING
  PER_UNIT_RECURRING
  ONE_TIME
}

enum SubscriptionInvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SubscriptionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  STRIPE
  RAZORPAY
  PAYPAL
  BANK_TRANSFER
  CRYPTO
  WALLET
}

// ==============================================================================
// ── Subscription & Billing Center Models ──────────────────────────────────────
// ==============================================================================

/// Master subscription plan definitions offered on the platform (e.g. Free, Starter, Pro, Enterprise)
model SubscriptionPlan {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  tagline         String?
  description     String?           @db.Text
  tier            PlanTier          @default(PRO)
  billingCycle    BillingCycle      @default(MONTHLY)
  price           Decimal           @db.Decimal(10, 2)
  discountPrice   Decimal?          @db.Decimal(10, 2)
  currency        PriceCurrency     @default(USD)
  trialDays       Int               @default(0)
  isPopular       Boolean           @default(false)
  isRecommended   Boolean           @default(false)
  isActive        Boolean           @default(true)
  isCustom        Boolean           @default(false)
  sortOrder       Int               @default(0)
  stripePlanId    String?
  razorpayPlanId  String?
  metadata        Json?             @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  benefits        PlanBenefit[]
  subscriptions   UserSubscription[]

  @@index([slug])
  @@index([tier, isActive])
  @@index([billingCycle])
}

/// Granular features and benefit entitlements associated with a SubscriptionPlan
model PlanBenefit {
  id           String           @id @default(cuid())
  planId       String
  title        String
  description  String?          @db.Text
  benefitType  BenefitType      @default(FEATURE)
  benefitValue String?          // e.g. "10", "50GB", "Unlimited", "24/7"
  isHighlighted Boolean         @default(false)
  isIncluded   Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

/// Catalog of premium services offered standalone or as plan attachments
model PremiumService {
  id               String            @id @default(cuid())
  categoryId       String?
  slug             String            @unique
  name             String
  shortDescription String
  fullDescription  String?           @db.Text
  iconUrl          String?
  bannerUrl        String?
  basePrice        Decimal           @db.Decimal(10, 2)
  currency         PriceCurrency     @default(USD)
  billingCycle     BillingCycle      @default(MONTHLY)
  isActive         Boolean           @default(true)
  isFeatured       Boolean           @default(false)
  sortOrder        Int               @default(0)
  metadata         Json?             @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category         ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addonServices    AddonService[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
}

/// Optional addon services that users can attach to their active UserSubscription
model AddonService {
  id               String                 @id @default(cuid())
  premiumServiceId String?
  slug             String                 @unique
  name             String
  description      String?                @db.Text
  pricingType      AddonPricingType       @default(FLAT_RECURRING)
  unitName         String?                // e.g. "Seat", "GB", "API Key"
  unitPrice        Decimal                @db.Decimal(10, 2)
  currency         PriceCurrency          @default(USD)
  billingCycle     BillingCycle           @default(MONTHLY)
  maxQuantity      Int?
  isActive         Boolean                @default(true)
  sortOrder        Int                    @default(0)
  stripePriceId    String?
  razorpayPlanId   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  premiumService   PremiumService?        @relation(fields: [premiumServiceId], references: [id], onDelete: SetNull)
  userAddons       UserSubscriptionAddon[]

  @@index([slug])
  @@index([premiumServiceId])
  @@index([isActive])
}

/// Active or historical user subscription instance
model UserSubscription {
  id                     String                  @id @default(cuid())
  subscriptionNumber     String                  @unique
  userId                 String
  planId                 String
  status                 SubscriptionStatus      @default(TRIALING)
  billingCycle           BillingCycle            @default(MONTHLY)
  quantity               Int                     @default(1)
  unitPrice              Decimal                 @db.Decimal(10, 2)
  discountAmount         Decimal                 @default(0) @db.Decimal(10, 2)
  taxAmount              Decimal                 @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal                 @db.Decimal(10, 2)
  currency               PriceCurrency           @default(USD)
  startDate              DateTime                @default(now())
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  canceledAt             DateTime?
  endedAt                DateTime?
  cancelAtPeriodEnd      Boolean                 @default(false)
  autoRenew              Boolean                 @default(true)
  paymentMethodId        String?
  stripeSubscriptionId   String?                 @unique
  razorpaySubscriptionId String?                 @unique
  metadata               Json?                   @default("{}")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan        @relation(fields: [planId], references: [id])
  addons                 UserSubscriptionAddon[]
  invoices               SubscriptionInvoice[]
  payments               SubscriptionPayment[]

  @@index([userId, status])
  @@index([planId])
  @@index([status, currentPeriodEnd])
}

/// Junction table connecting active user subscriptions with selected addon services
model UserSubscriptionAddon {
  id                 String           @id @default(cuid())
  userSubscriptionId String
  addonServiceId     String
  quantity           Int              @default(1)
  unitPrice          Decimal          @db.Decimal(10, 2)
  totalPrice         Decimal          @db.Decimal(10, 2)
  currency           PriceCurrency    @default(USD)
  addedAt            DateTime         @default(now())
  removedAt          DateTime?
  isActive           Boolean          @default(true)

  userSubscription   UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  addonService       AddonService     @relation(fields: [addonServiceId], references: [id])

  @@unique([userSubscriptionId, addonServiceId])
  @@index([userSubscriptionId])
  @@index([addonServiceId])
}

/// Recurring billing invoices generated per subscription cycle
model SubscriptionInvoice {
  id                 String                    @id @default(cuid())
  invoiceNumber      String                    @unique
  userSubscriptionId String
  userId             String
  status             SubscriptionInvoiceStatus @default(OPEN)
  currency           PriceCurrency             @default(USD)
  subtotal           Decimal                   @db.Decimal(10, 2)
  taxTotal           Decimal                   @default(0) @db.Decimal(10, 2)
  discountTotal      Decimal                   @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal                   @db.Decimal(10, 2)
  amountPaid         Decimal                   @default(0) @db.Decimal(10, 2)
  amountDue          Decimal                   @db.Decimal(10, 2)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  paidAt             DateTime?
  voidedAt           DateTime?
  pdfUrl             String?
  lineItems          Json                      @default("[]")
  billingAddress     Json?                     @default("{}")
  stripeInvoiceId    String?                   @unique
  razorpayInvoiceId  String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  userSubscription   UserSubscription          @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           SubscriptionPayment[]

  @@index([userId, status])
  @@index([userSubscriptionId])
  @@index([invoiceNumber])
  @@index([status, dueDate])
}

/// Payment transaction records linked to subscription invoices
model SubscriptionPayment {
  id                    String                    @id @default(cuid())
  paymentNumber         String                    @unique
  subscriptionInvoiceId String?
  userSubscriptionId    String
  userId                String
  amount                Decimal                   @db.Decimal(10, 2)
  currency              PriceCurrency             @default(USD)
  status                SubscriptionPaymentStatus @default(PENDING)
  paymentMethod         SubscriptionPaymentMethod @default(CREDIT_CARD)
  gateway               PaymentGateway            @default(STRIPE)
  gatewayTransactionId  String?                   @unique
  failureReason         String?
  paidAt                DateTime?
  metadata              Json?                     @default("{}")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  subscriptionInvoice   SubscriptionInvoice?      @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: SetNull)
  userSubscription      UserSubscription          @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userSubscriptionId])
  @@index([subscriptionInvoiceId])
  @@index([gatewayTransactionId])
}

// ── Customer Service Management Platform ─────────────────────────────────────
// Post-purchase lifecycle: one PurchasedService per paid order item. Backend is
// the single source of truth for status, credentials, resources, and access.

enum PurchasedServiceStatus {
  PENDING_DEPLOYMENT
  DEPLOYING
  ACTIVE
  PAUSED
  SUSPENDED
  EXPIRED
  ARCHIVED
  DELETED
}

enum ServiceDeploymentStatus {
  PENDING
  PREPARING
  DEPLOYING
  DATABASE_CONFIG
  GENERATING_CREDENTIALS
  QUALITY_CHECK
  COMPLETED
  FAILED
}

enum ServiceUpgradeStatus {
  PENDING
  PAID
  APPLIED
  REJECTED
  CANCELLED
}

/// A customer's owned service instance — the "living workspace" created after payment.
model PurchasedService {
  id                    String                 @id @default(cuid())
  userId                String
  orderId               String
  orderItemId           String
  productId             String
  tierId                String?
  status                PurchasedServiceStatus @default(PENDING_DEPLOYMENT)
  purchaseDate          DateTime               @default(now())
  activationDate        DateTime?
  expiryDate            DateTime?
  renewalDate           DateTime?
  autoRenew             Boolean                @default(false)
  deploymentPriority    Int                    @default(0)
  estimatedCompletionAt DateTime?
  /// Admin-managed workspace config: URLs, credentials, resources, docker,
  /// domain/SSL, env vars, support level, notes. Passwords encrypted at rest
  /// inside this JSON via lib/encryption before persistence.
  config                Json                   @default("{}")
  renewalReminderSentAt DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user       User      @relation(fields: [userId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id])
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  deployment ServiceDeployment?
  timeline   ServiceTimelineEvent[]
  upgrades   ServiceUpgrade[]

  @@index([userId, status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([status, expiryDate])
}

/// Deployment request/state for a purchased service (admin deployment queue).
model ServiceDeployment {
  id                 String                  @id @default(cuid())
  purchasedServiceId String                  @unique
  status             ServiceDeploymentStatus @default(PENDING)
  queuePosition      Int?
  /// Ordered [{ status, at, by }] transition history.
  statusHistory      Json                    @default("[]")
  adminNotes         String?
  failureReason      String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  purchasedService PurchasedService @relation(fields: [purchasedServiceId], references: [id], onDelete: Cascade)

  @@index([status, queuePosition])
  @@index([status, createdAt])
}

/// Timestamped customer/service timeline (admin monitoring + audit).
model ServiceTimelineEvent {
  id                 String   @id @default(cuid())
  purchasedServiceId String
  /// e.g. PAYMENT_RECEIVED, DEPLOYMENT_STARTED, CREDENTIALS_GENERATED,
  /// UPGRADE_PURCHASED, SERVICE_PAUSED, RENEWAL_COMPLETED, SUPPORT_REQUEST…
  type               String
  message            String
  metadata           Json     @default("{}")
  actorId            String?
  createdAt          DateTime @default(now())

  purchasedService PurchasedService @relation(fields: [purchasedServiceId], references: [id], onDelete: Cascade)

  @@index([purchasedServiceId, createdAt])
  @@index([type, createdAt])
}

/// An add-on / upgrade purchased (or requested) against an owned service.
model ServiceUpgrade {
  id                 String               @id @default(cuid())
  purchasedServiceId String
  userId             String
  addonId            String
  status             ServiceUpgradeStatus @default(PENDING)
  paymentId          String?
  orderId            String?
  appliedAt          DateTime?
  appliedBy          String?
  /// Snapshot of the addon at purchase time (name, price, currency, specs).
  snapshot           Json                 @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  purchasedService PurchasedService @relation(fields: [purchasedServiceId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id])

  @@index([purchasedServiceId, status])
  @@index([userId, status])
  @@index([status, createdAt])
}

/// Admin-managed upgrade/add-on catalog. All pricing lives here — the frontend
/// never hardcodes prices.
model AddonCatalogItem {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  description           String?
  /// e.g. DOMAIN, STORAGE, DATABASE, COMPUTE, ACCOUNTS, AI_CREDITS, BRANDING,
  /// INTEGRATIONS, ANALYTICS, SUPPORT
  category              String   @default("GENERAL")
  price                 Decimal  @db.Decimal(12, 2)
  currency              String   @default("INR")
  /// Free-form spec JSON shown to customers (e.g. { "storageGb": 50 }).
  specs                 Json     @default("{}")
  isActive              Boolean  @default(true)
  isPopular             Boolean  @default(false)
  /// Empty = applies to all products.
  applicableProductIds  String[]
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive, category])
}

