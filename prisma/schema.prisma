generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  SUPER_ADMIN
  SUB_ADMIN
  VENDOR
  CLIENT
  GUEST
}

enum SubadminApplicationStatus {
  PENDING
  SHORTLISTED
  APPROVED
  REJECTED
}

enum SubadminAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  REVOKED
}

enum AdminApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum Department {
  TECH
  MARKETING
  FINANCE
  AI
  OPERATIONS
}

enum ProductType {
  SAAS
  SERVICE
  AI_AGENT
  AI_TOOL
  WEBSITE
  AUTOMATION
  API
  TEMPLATE
  PLUGIN
  PROMPT
  WORKFLOW
  DIGITAL
  CLOUD_SERVICE
  SUPPORT_PLAN
  CONSULTING
  ADDON
  CREDIT_PACK
  ENTERPRISE
  CUSTOM
}

enum ProductStatus {
  DRAFT
  AVAILABLE
  RESERVED
  EXPIRED
  REPUBLISH_PENDING
  SCHEDULED
  ARCHIVED
  HIDDEN
  MAINTENANCE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
  WEEKLY
  LIFETIME
  PER_SEAT
  USAGE_BASED
  TOKEN_BASED
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  PAUSED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentGateway {
  STRIPE
  RAZORPAY
  PAYTM
  PHONEPE
  PAYPAL
  CRYPTO
  MANUAL
}

enum ProjectStatus {
  PENDING
  ACTIVE
  REVIEW
  COMPLETED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum NotifType {
  PAYMENT
  ORDER
  VENDOR
  TICKET
  SUBSCRIPTION
  PROJECT
  SYSTEM
  CHAT
  AI_USAGE
  COMMERCE
}

enum VendorStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum VendorType {
  SAAS_CREATOR
  AI_DEVELOPER
  AUTOMATION_BUILDER
  AGENCY
  ENTERPRISE_SELLER
  FREELANCER
  API_PROVIDER
  CONSULTANT
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING
  AWAITING_VERIFICATION
  PAID
  PROCESSING
  FULFILLED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  DISPUTED
}

enum FulfillmentType {
  HOSTED
  DOWNLOAD
  API_ACCESS
  SERVICE_DELIVERY
  ENTERPRISE_ONBOARDING
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  HELD
}

enum ServiceEngagementStatus {
  PROPOSED
  ACCEPTED
  ACTIVE
  IN_REVIEW
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
  DISPUTED
}

enum AgentDeploymentStatus {
  QUEUED
  DEPLOYING
  LIVE
  FAILED
  PAUSED
  ARCHIVED
}

enum MetricEventType {
  VIEW
  SEARCH
  CART_ADD
  CHECKOUT_STARTED
  PURCHASE
  SUBSCRIPTION_CREATED
  AI_USAGE
  API_CALL
  REVIEW_CREATED
  TICKET_CREATED
  DEPLOYMENT_EVENT
}

enum CouponType {
  PERCENTAGE
  FLAT
  TRIAL_EXTENSION
  FREE_CREDITS
  FREE_TOKENS
  FREE_ADDON
  UPGRADE
  REFERRAL
  FIRST_TIME
  FESTIVAL
  FLASH_SALE
  INFLUENCER
  AFFILIATE
  GEO_TARGETED
  RETENTION
}

enum AIUsageStatus {
  SUCCESS
  FAILED
  QUOTA_EXCEEDED
}

enum WebhookSource {
  STRIPE
  RAZORPAY
  PAYTM
  PHONEPE
  INTERNAL
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD
}

model User {
  id               String                       @id @default(cuid())
  email            String                       @unique
  clerkUserId      String?                      @unique
  name             String
  passwordHash     String?
  role             Role                         @default(CLIENT)
  department       Department?
  avatarUrl        String?
  phone            String?
  emailVerified    DateTime?
  phoneVerified    DateTime?
  verificationToken    String?                      @unique
  verificationTokenExp DateTime?
  resetToken           String?                      @unique
  resetTokenExp        DateTime?
  otpCode              String?
  otpExpiresAt         DateTime?
  timezone         String                       @default("Asia/Kolkata")
  isVerified       Boolean                      @default(false)
  twoFactorEnabled Boolean                      @default(false)
  twoFactorSecret  String?
  stripeCustomerId String?                      @unique
  lastLoginAt      DateTime?
  notifPrefs       Json                         @default("{}")
  embedding        Unsupported("vector(1536)")?
  isBanned         Boolean                      @default(false)
  bannedAt         DateTime?
  banReason        String?
  // Preview abuse tracking
  previewCount     Int                          @default(0)
  suspiciousScore  Int                          @default(0)
  lastPreviewAt    DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

    permissions     UserPermission[]
    subscriptions   Subscription[]
    payments        Payment[]
    serviceOrders   ServiceOrder[]
    clientProjects  Project[]             @relation("ClientProjects")
  managedProjects Project[]             @relation("ManagerProjects")
  clientTickets   Ticket[]              @relation("ClientTickets")
  assignedTickets Ticket[]              @relation("AssignedTickets")
  invoices        Invoice[]
  notifications   Notification[]
  reviews         ProductReview[]
  auditLogs       AuditLog[]
  leads           Lead[]                @relation("AssignedLeads")
  apiKeys         ApiKey[]
  sessions        UserSession[]
  chatMessages    ChatMessage[]
  posts           BlogPost[]
  teamMemberships TeamMember[]
  accounts        Account[]
  aiUsageLogs     AIUsageLog[]
  couponUsages    CouponUsage[]
  vendorProfiles  VendorProfile[]
  carts           Cart[]
  orders          Order[]
  entitlements    CustomerEntitlement[]
  refundRequests  RefundRequest[]
  demoSessions    DemoSession[]
  serviceRequests ServiceEngagement[]   @relation("ClientServiceEngagements")
  metricEvents    PlatformMetricEvent[]
  previewSessions PreviewSession[]
    paymentVerifications PaymentVerification[]
    emailCampaigns   EmailCampaign[]
    serviceSubscriptions ServiceSubscription[]
    serviceOwnerships    ServiceOwnership[]
    serviceEntitlements  ServiceEntitlement[]
    credentialRequests   CredentialRequest[]
    subadminAccount      SubadminAccount?
    createdSubadmins     SubadminAccount[]        @relation("SubadminCreatedBy")
    updatedSubadmins     SubadminAccount[]        @relation("SubadminUpdatedBy")
    reviewedSubadminApplications SubadminApplication[] @relation("SubadminApplicationReviewedBy")
    subadminPermissionGrants SubadminPermission[] @relation("SubadminPermissionGrantedBy")
    subadminActivityLogs SubadminActivityLog[]    @relation("SubadminActivityActor")
    requestedAdminApprovals SubadminApprovalRequest[] @relation("AdminApprovalRequestedBy")
    reviewedAdminApprovals  SubadminApprovalRequest[] @relation("AdminApprovalReviewedBy")
    adminPortalSettingUpdates AdminPortalSetting[] @relation("AdminPortalSettingUpdatedBy")
    serviceDiscoveryEvents ServiceDiscoveryEvent[]
    serviceInterestProfile ServiceInterestProfile?
    serviceCampaignEvents ServiceCampaignEvent[]
    customServiceRequests CustomServiceRequest[] @relation("CustomServiceRequestClient")
    customServiceMessages CustomServiceDiscussionMessage[] @relation("CustomServiceMessageSender")
    customServicePortalSettingUpdates CustomServicePortalSetting[] @relation("CustomServicePortalSettingUpdatedBy")
    userSubscriptions    UserSubscription[]
    subscriptionInvoices SubscriptionInvoice[]
    subscriptionPayments SubscriptionPayment[]
    purchasedServices    PurchasedService[]
    serviceUpgrades      ServiceUpgrade[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  action      String
  resource    String
  description String?
  users       UserPermission[]

  @@index([action, resource])
}

model UserPermission {
  userId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  grantedBy    String?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VendorProfile {
  id                String       @id @default(cuid())
  userId            String
  slug              String       @unique
  displayName       String
  legalName         String?
  type              VendorType
  status            VendorStatus @default(PENDING)
  headline          String?
  description       String?      @db.Text
  websiteUrl        String?
  supportEmail      String?
  logoUrl           String?
  coverUrl          String?
  badges            String[]
  verificationNotes String?
  verifiedAt        DateTime?
  sellerScore       Float        @default(0)
  rankingScore      Float        @default(0)
  averageRating     Float        @default(0)
  reviewCount       Int          @default(0)
  totalSales        Int          @default(0)
  totalRevenue      Decimal      @default(0) @db.Decimal(12, 2)
  commissionRate    Decimal      @default(15.00) @db.Decimal(5, 2)
  payoutSettings    Json         @default("{}")
  analyticsSnapshot Json         @default("{}")
  onboardingState   Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  payouts            VendorPayout[]
  serviceEngagements ServiceEngagement[] @relation("VendorServiceEngagements")

  @@index([userId])
  @@index([status, type])
  @@index([rankingScore])
}

model Product {
  id                 String                       @id @default(cuid())
  vendorId           String?
  slug               String                       @unique
  name               String
  tagline            String
  description        String
  longDescription    String?                      @db.Text
  type               ProductType
  category           String?
  subcategory        String?
  isPremium          Boolean                      @default(false)
  proPoints          Int                          @default(0)
  status             ProductStatus                @default(DRAFT)
  scheduledAt        DateTime?
  thumbnailUrl       String?
  iconUrl            String?
  bannerUrl          String?
  screenshotUrls     String[]
  videoUrls          String[]
  demoUrl            String?
  documentationUrl   String?
  mediaMetadata      Json                         @default("{}")
  demoTemplateId     String?
  features           Json
  faqs               Json                         @default("[]")
  documentation      Json                         @default("{}")
  setupGuide         Json                         @default("{}")
  integrationCatalog Json                         @default("[]")
  roadmap            Json                         @default("[]")
  changelog          Json                         @default("[]")
  supportPlans       Json                         @default("[]")
  bundleOffers       Json                         @default("[]")
  commerceConfig     Json                         @default("{}")
  aiConfig           Json                         @default("{}")
  // Preview configuration (admin-controlled per product)
  previewEnabled     Boolean                      @default(false)
  previewConfig      Json                         @default("{}")
  // previewConfig shape: { url, domain, durationMinutes, maxPreviewsPerUser,
  //   sessionQuota, ipRestrictions, allowedDevices, rateLimit,
  //   analyticsEnabled, requireLogin }
  // Delivery config (ALL sensitive values AES-256-GCM encrypted — never returned to frontend)
  deliveryConfig     Json                         @default("{}")
  // deliveryConfig shape: { saasUrl_enc, deploymentUrl_enc, aiDashboardUrl_enc,
  //   cloudInstanceUrl_enc, username_enc, password_enc, apiKeys_enc,
  //   trialCredentials_enc, onboardingInstructions, accessDocUrl, renewalBehavior }
  // Access URLs (non-sensitive, admin-configured, shown only to active owners)
  productAccessUrl    String?
  productLoginUrl     String?
  productDashboardUrl String?
  productAccessNotes  String?                      @db.Text
  // Inventory control
  inventoryEnabled   Boolean                      @default(false)
  inventoryCount     Int?
  inventoryHoldCount Int                          @default(0)
  soldOutBehavior    String                       @default("HIDE")
  // HIDE | SHOW_SOLDOUT | SHOW_WAITLIST
  techStack          String[]
  tags               String[]
  // Reservation Lifecycle
  assignedUserId     String?
  assignedEmail      String?
  reservedUntil      DateTime?
  // SEO
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String[]
  // Badges
  isFeatured         Boolean                      @default(false)
  isPinned           Boolean                      @default(false)
  isTrending         Boolean                      @default(false)
  isBestSeller       Boolean                      @default(false)
  badgeText          String?
  // Analytics
  averageRating      Float                        @default(0)
  reviewCount        Int                          @default(0)
  viewCount          Int                          @default(0)
  // Versioning / locking
  version            Int                          @default(1)
  lockedBy           String?
  lockedAt           DateTime?
  createdBy          String
  lastEditedBy       String?
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  tiers              ProductTier[]
  reviews            ProductReview[]
  demoSessions       DemoSession[]
  subscriptions      Subscription[]
  versions           ProductVersion[]
  vendor             VendorProfile?        @relation(fields: [vendorId], references: [id])
  cartItems          CartItem[]
  orderItems         OrderItem[]
  entitlements       CustomerEntitlement[]
  credentialRequests CredentialRequest[]
  serviceEngagements ServiceEngagement[]
  agentDeployments   AgentDeployment[]
  metricEvents       PlatformMetricEvent[]
  previewSessions    PreviewSession[]
  serviceProfile     ProductServiceProfile?
  purchasedServices  PurchasedService[]

  @@index([slug])
  @@index([vendorId])
  @@index([type, status])
  @@index([averageRating])
  @@index([isFeatured])
  @@index([category, type])
}

// ── Preview Sessions (DB-persisted, user+product scoped) ──────────────────────
// Sessions survive login/logout and enforce per-product preview quotas.
// Admin configures duration and quota via Product.previewConfig JSON.
model PreviewSession {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  /// ACTIVE | EXPIRED | CONVERTED
  status      String   @default("ACTIVE")
  expiresAt   DateTime
  /// Stores resolved config snapshot at session creation time
  config      Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([productId])
  @@index([expiresAt])
  @@index([userId, productId])
}

enum VerificationStatus {
  AWAITING_VERIFICATION
  APPROVED
  REJECTED
}

model PaymentVerification {
  id                 String             @id @default(cuid())
  orderId            String             @unique
  userId             String
  utrNumber          String             @unique
  claimedAmount      Decimal?           @db.Decimal(12, 2)
  screenshotUrl      String?
  verificationStatus VerificationStatus @default(AWAITING_VERIFICATION)
  adminTransactionId String?
  adminActualAmount  Decimal?           @db.Decimal(12, 2)
  mismatchReason     String?
  reviewAttemptCount Int                @default(0)
  lastReviewedAt     DateTime?
  submittedAt        DateTime           @default(now())
  verifiedAt         DateTime?
  verifiedBy         String?            // Admin User ID
  
  order              Order              @relation(fields: [orderId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
}

model ProductTier {
  id               String           @id @default(cuid())
  productId        String
  name             String
  description      String?
  price            Decimal          @db.Decimal(10, 2)
  discountPrice    Decimal?         @db.Decimal(10, 2)
  currency         String           @default("USD")
  interval         BillingInterval
  features         String[]
  limits           Json?
  // Enhanced pricing
  trialDays        Int              @default(0)
  introPrice       Decimal?         @db.Decimal(10, 2)
  introPeriodDays  Int              @default(0)
  flashSalePrice   Decimal?         @db.Decimal(10, 2)
  flashSaleEndsAt  DateTime?
  taxRate          Float            @default(0)
  taxInclusive     Boolean          @default(false)
  setupFee         Decimal?         @db.Decimal(10, 2)
  maxSeats         Int?
  minSeats         Int              @default(1)
  usageUnit        String?
  usageUnitPrice   Decimal?         @db.Decimal(10, 8)
  regionalPrices   Json             @default("{}")
  entitlementRules Json             @default("{}")
  aiQuota          Json             @default("{}")
  supportLevel     String?
  fulfillmentType  FulfillmentType  @default(HOSTED)
  // Badges
  isPopular        Boolean          @default(false)
  isRecommended    Boolean          @default(false)
  isActive         Boolean          @default(true)
  // Gateway IDs
  stripePriceId    String?
  stripeProductId  String?
  razorpayPlanId   String?
  // Versioning
  sortOrder        Int              @default(0)
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]
  pricingHistory   PricingHistory[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([productId])
  @@index([isActive])
}

model ProductServiceProfile {
  id              String   @id @default(cuid())
  productId       String   @unique
  headline        String?
  summary         String?  @db.Text
  capacity        Json     @default("{}")
  freeServices    Json     @default("[]")
  paidAddons      Json     @default("[]")
  upgradePaths    Json     @default("[]")
  documentation   Json     @default("[]")
  tutorials       Json     @default("[]")
  supportBenefits Json     @default("[]")
  hiddenFields    String[]
  isPublished     Boolean  @default(true)
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@index([updatedAt])
}

model ProductReview {
  id               String       @id @default(cuid())
  productId        String
  userId           String
  rating           Int
  title            String
  body             String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())
  product          Product      @relation(fields: [productId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId, rating])
}

model DemoSession {
  id                String    @id @default(cuid())
  productId         String
  userId            String?
  templateId        String
  // Original token fields
  sessionToken      String    @unique
  mockDataJson      Json      @default("{}")
  isExpired         Boolean   @default(false)
  convertedAt       DateTime?
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  // Enterprise preview session fields
  signedToken       String?   @unique
  previewUrl        String?
  durationMinutes   Int       @default(10)
  // Auth + tracking
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  referrer          String?
  // State
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  revokedReason     String?
  // Analytics
  viewedPages       Int       @default(0)
  lastActivityAt    DateTime?
  convertedToOrder  Boolean   @default(false)
  abuseFlag         Boolean   @default(false)
  abuseFlagReason   String?

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionToken])
  @@index([signedToken])
  @@index([expiresAt])
  @@index([userId])
  @@index([isRevoked, isExpired])
}

model Subscription {
  id                 String      @id @default(cuid())
  userId             String
  productId          String
  tierId             String
  status             SubStatus   @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean     @default(false)
  cancelledAt        DateTime?
  trialEndsAt        DateTime?
  stripeSubId        String?     @unique
  razorpaySubId      String?     @unique
  metadata           Json?       @default("{}")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id])
  product            Product     @relation(fields: [productId], references: [id])
  tier               ProductTier @relation(fields: [tierId], references: [id])
  payments           Payment[]
  invoices           Invoice[]

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Payment {
  id               String         @id @default(cuid())
  orderId          String?
  subscriptionId   String?
  userId           String
  amount           Decimal
  currency         String         @default("USD")
  status           PaymentStatus  @default(PENDING)
  gateway          PaymentGateway
  gatewayPaymentId String?        @unique
  gatewayOrderId   String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id])
  order            Order?         @relation(fields: [orderId], references: [id])
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id])
  invoice          Invoice?

  @@index([userId])
  @@index([status])
  @@index([orderId])
}

model Invoice {
  id             String        @id @default(cuid())
  paymentId      String        @unique
  orderId        String?
  subscriptionId String?
  userId         String
  number         String        @unique
  pdfUrl         String?
  totalAmount    Decimal
  taxAmount      Decimal       @default(0)
  currency       String        @default("USD")
  status         String        @default("PAID")
  lineItems      Json
  issuedAt       DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  payment        Payment       @relation(fields: [paymentId], references: [id])
  order          Order?        @relation(fields: [orderId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([number])
}

model Cart {
  id            String     @id @default(cuid())
  userId        String?
  sessionId     String?
  status        CartStatus @default(ACTIVE)
  currency      String     @default("USD")
  region        String?
  couponCode    String?
  subtotal      Decimal    @default(0) @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal    @default(0) @db.Decimal(12, 2)
  metadata      Json       @default("{}")
  abandonedAt   DateTime?
  convertedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]
  order Order?

  @@index([userId, status])
  @@index([sessionId])
  @@index([updatedAt])
}

model CartItem {
