# ─────────────────────────────────────────────────────────────────────────────
# SaaS Platform — Environment Variables Template
# Copy this file to .env and fill in all values before running the application.
# NEVER commit the filled-in .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://saasuser:yourpassword@localhost:5432/saasdb
POSTGRES_DB=saasdb
POSTGRES_USER=saasuser
POSTGRES_PASSWORD=yourpassword

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispassword@localhost:6379
REDIS_PASSWORD=redispassword

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-min-32-chars-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=NexusAI <onboarding@resend.dev>

# ── Cloudflare R2 / AWS S3 (Storage) ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=saas-invoices
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# ── Pusher (Real-time) ────────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Upstash Redis (Rate Limiting — can reuse main Redis or use Upstash) ───────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── GST / Invoice ─────────────────────────────────────────────────────────────
COMPANY_NAME="Your Company Pvt Ltd"
COMPANY_GST_NUMBER=
COMPANY_PAN=
COMPANY_ADDRESS="Your address, City, State - 000000"
COMPANY_EMAIL=billing@yourdomain.com

# ── Firebase Phone OTP ────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Twilio SMS OTP (pre-payment phone verification) ────────────────────────────
# Required to activate the phone OTP gate before payment.
# Get these from https://console.twilio.com (Account Info → Live credentials).
# Phone numbers must be E.164 (e.g. +15551234567). The OTP flow uses the
# Twilio Messages API (plain SMS) — no Verify service SID is needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# Optional: WhatsApp sender for OTP delivery (falls back to SMS if unset)
TWILIO_WHATSAPP_FROM=

# OTP expiry window in minutes (default 10)
OTP_EXPIRY_MINUTES=10

# ── AI (OpenAI / TokenRouter-compatible gateway) ───────────────────────────────
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.tokenrouter.com/v1

# ── Abhibhi Agent Gateway (Phase 1 foundation — additive, opt-in) ─────────────
# Master switch. The gateway is disabled by default; set to 1 to enable
# /api/agent-gateway. Disabled == GATEWAY_DISABLED on every request.
AGENT_GATEWAY_ENABLED=0
# Externally visible host, for documentation/health output only — never used
# for auth decisions.
AGENT_GATEWAY_HOST=https://api.yourdomain.com
AGENT_GATEWAY_MAX_BODY_BYTES=262144
AGENT_GATEWAY_REQUEST_TIMEOUT_MS=30000
AGENT_GATEWAY_RATE_LIMIT_PER_MINUTE=60
AGENT_GATEWAY_RATE_LIMIT_PER_HOUR=1000
AGENT_GATEWAY_MAX_CLOCK_SKEW_SECONDS=300
AGENT_GATEWAY_NONCE_TTL_SECONDS=600
# Enables the HMAC signed-request authenticator (X-Abhibhi-* headers).
# Bearer-token auth is always available regardless of this flag.
AGENT_GATEWAY_SIGNING_ENABLED=0
AGENT_GATEWAY_ENVIRONMENT=development
# TEMPORARY Phase 1 bootstrap credential store (see
# lib/agent-gateway/auth/credential-store.ts). A JSON array of
# { connectionId, ownerId, agentId?, teamId?, status?, scopes?, bearerToken?,
# keyId?, signingSecret? }. Replaced by a real AgentConnection-backed store
# in Phase 2 — do not treat this as a long-term secret storage mechanism.
# AGENT_GATEWAY_CREDENTIALS_JSON=[]

